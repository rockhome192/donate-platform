# =====================================================================
# donate-platform — environment reference
#
# There is NO root .env. Prisma and Next.js both resolve .env from the app
# directory, so each service carries its own:
#
#   apps/web/.env       everything under [web] below
#   apps/realtime/.env  everything under [realtime] below
#
# This matches production, where Vercel and Railway hold separate settings.
# The two REALTIME_*_SECRET values must be IDENTICAL on both sides or the
# overlay ticket fails to verify.
#
# Nothing here is a real secret. Never commit a real .env.
# =====================================================================


# ---------------------------------------------------------------------
# [web] apps/web/.env
# ---------------------------------------------------------------------

# Neon pooled endpoint — used by the app at runtime.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Neon direct endpoint (same host WITHOUT "-pooler") — used by migrations only.
# PgBouncer cannot hold the session-level locks prisma migrate needs.
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# "true" enables POST /api/demo/complete-donation, which posts a SIMULATED
# webhook through the real pipeline. Anything else and the route 404s.
# Omise has no public API for marking a test charge paid — see DESIGN.md 4.3.
DEMO_MODE="true"
MOCK_WEBHOOK_SECRET="dev-only-mock-secret"

# omise | mock. Only ever TEST keys — this project has no live-mode path.
# The webhook secret is the base64 string from Dashboard > Webhooks; it is
# decoded before the HMAC, and it is NOT the API secret key.
PAYMENT_PROVIDER="mock"
OMISE_PUBLIC_KEY="pkey_test_..."
OMISE_SECRET_KEY="skey_test_..."
OMISE_WEBHOOK_SECRET=""

# Bearer for /api/cron/reconcile. Vercel Cron sends it automatically when set
# here; apps/realtime needs the SAME value to drive the 5-minute cycle.
# openssl rand -base64 32
CRON_SECRET="replace-me"

# Shared with [realtime] — must match exactly.
REALTIME_JWT_SECRET="replace-me"
REALTIME_INTERNAL_SECRET="replace-me"
REALTIME_HTTP_URL="http://localhost:8080"
# Browsers refuse ws:// from an https:// page — use wss:// in production.
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:8080"

# Optional. Unset means the rate limiter fails open and logs a warning.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cloudflare R2, for avatar uploads on /dashboard/profile. ALL FIVE or none —
# with any one missing the upload button is disabled and everything else works.
# The app signs a short-lived PUT itself (lib/storage.ts); the bytes go from the
# browser straight to R2 and never through a serverless function.
#
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY come from an R2 API token with Object
# Read & Write on this bucket only. R2_PUBLIC_BASE_URL is the bucket's public
# r2.dev address or a custom domain — the bucket must allow public READ, and its
# CORS policy must allow PUT from the site's origin, or the browser's upload is
# blocked before it leaves the page.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# --- text to speech (optional) ---
# Reads the donor's message aloud over the alert. Leave empty and TTS is simply
# off: the switch in /dashboard/alerts renders disabled and every donation still
# alerts normally.
#
# It has to be a server-side API rather than the browser's own speechSynthesis,
# because OBS renders a Browser Source with CEF, CEF does not implement the Web
# Speech API, and getVoices() returns an empty list there with no error. Azure
# because it publishes Thai neural voices and its F0 tier is 500,000 characters
# a month that does not expire (F0 also caps at 20 requests per 60s).
#
# AZURE_SPEECH_REGION is the region the Speech resource was created in, e.g.
# southeastasia — a key from one region is rejected by every other one.
# TTS_VOICE defaults to th-TH-PremwadeeNeural; th-TH-NiwatNeural is the male
# voice. TTS also needs the R2 vars above: the audio is stored and the overlay
# is handed a URL.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
TTS_VOICE=""
TTS_LOCALE=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ---------------------------------------------------------------------
# [realtime] apps/realtime/.env
# ---------------------------------------------------------------------

# Local only. Railway injects PORT itself — setting it there makes the edge
# proxy and the process disagree about which port is live.
PORT="8080"
# Same values as [web] above.
REALTIME_JWT_SECRET="replace-me"
REALTIME_INTERNAL_SECRET="replace-me"

# Comma-separated Origins allowed to open a WebSocket. UNSET MEANS ALLOW ANY,
# with a warning at boot — fine for a fresh clone, not for production. There is
# no preflight on a WebSocket handshake, so this is the only thing standing
# between a random page and an open socket to this service.
# Production: the deployed site's origin, e.g. "https://donate-platform.vercel.app"
ALLOWED_ORIGINS=""

# The reconciler clock. Vercel Hobby crons cannot run more often than once a
# day, so this long-lived process is what drives the 5-minute cycle
# (DESIGN.md 7.4). Unset either one and the driver stays off.
WEB_APP_URL="http://localhost:3000"
CRON_SECRET="replace-me"
RECONCILE_INTERVAL_MS="300000"

# Slip verification (DESIGN.md 7.3). "fake" keeps the real upstream out of
# reach; "slipok" needs both values below. Free tier is 100 slips a month.
SLIP_VERIFIER=fake
SLIPOK_API_KEY=SLIPOK-not-a-real-one
SLIPOK_BRANCH_ID=00000

# Slip diagnostics: puts the observed receiver into the error response.
# Never takes effect when NODE_ENV=production. Off unless set to "true".
SLIP_DEBUG=false

# Donation by bank transfer + slip. OFF unless "true" — the public demo says it
# takes no real money, and this is the one path that would make that untrue.
SLIP_DONATIONS_ENABLED=false
