# =====================================================================
# donate-platform — copy to .env and fill in.
# NOTHING here is a real secret. Never commit .env / .env.local
# =====================================================================

# ---------- Database (Neon) ----------
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ---------- NextAuth ----------
# generate: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# ---------- Demo mode ----------
# "true" enables POST /api/demo/complete-donation (a SIMULATED webhook).
# MUST be unset/false in production, or the endpoint 404s. See DESIGN.md 4.3
DEMO_MODE="true"
MOCK_WEBHOOK_SECRET="dev-only-mock-secret"

# ---------- Payment provider ----------
# omise | mock
PAYMENT_PROVIDER="mock"
OMISE_PUBLIC_KEY="pkey_test_..."
OMISE_SECRET_KEY="skey_test_..."
OMISE_WEBHOOK_SECRET=""

# ---------- Realtime (apps/realtime on Railway) ----------
# Shared HS256 secret: web signs the 60s overlay ticket, realtime verifies it.
# Both services MUST have the identical value. openssl rand -base64 32
REALTIME_JWT_SECRET="replace-me"
# HMAC secret for POST /internal/publish and /internal/disconnect
REALTIME_INTERNAL_SECRET="replace-me"
# Where apps/web publishes to (no trailing slash)
REALTIME_HTTP_URL="http://localhost:8080"
# Where the browser overlay connects (wss:// in production — ws:// breaks on https)
NEXT_PUBLIC_REALTIME_WS_URL="ws://localhost:8080"

# ---------- Rate limiting (Upstash Redis) ----------
# Optional in dev: if unset the limiter fails OPEN and logs a warning.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------- Site ----------
# Must be the real deployed origin or OG/canonical URLs fall back to localhost
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
